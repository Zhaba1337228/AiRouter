# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=airouter
POSTGRES_USER=airouter
POSTGRES_PASSWORD=change-me-strong-password

# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=8200
FRONTEND_PORT=3000

# Admin token — used as the password in the login form
# Run `openssl rand -hex 32` to generate a strong token
ADMIN_TOKEN=change-me-admin-token

# Secret URL path for admin API routes (no leading slash).
# All admin endpoints will be at /<ADMIN_PATH>/keys, /<ADMIN_PATH>/stats, etc.
# Run `openssl rand -hex 6` to generate a random path segment.
# The frontend must be rebuilt whenever this changes (VITE_ADMIN_PATH must match).
ADMIN_PATH=admin

# ─── Upstream AI API ─────────────────────────────────────────────────────────
UPSTREAM_BASE_URL=https://api.ecomagent.in
UPSTREAM_API_KEY=

# ─── Frontend ────────────────────────────────────────────────────────────────
# URL the browser uses to reach the backend (change to your server's IP/domain)
VITE_API_URL=http://localhost:8200
